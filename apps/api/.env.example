DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Seed opcional: si se definen, `prisma db seed` crea el usuario demo con estos
# valores. Nunca fijar credenciales reales aquí: se configuran en .env (gitignored).
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=
